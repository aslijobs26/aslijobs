# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined
# into the browser bundle at build time, so redeploy after changing them.

# Backend API base. Production: https://aslijobs-backend.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Microsoft Clarity project id (clarity.microsoft.com > Settings > Setup).
# An empty value disables Clarity. Clear it in .env.local if local test
# sessions should stay out of the production Clarity project.
NEXT_PUBLIC_CLARITY_PROJECT_ID=zbgpw96muj

# Firebase web app config (Firebase console > Project settings > Your apps).
# Google Analytics runs only when the API key, project id, app id and
# measurement id are all set. These identify the web app and are public in
# the browser bundle; restrict the API key to your domains in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAiWzTnHfpfOLL3PjcNkdjN6MWG1UXaJe4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=asli-jobs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=asli-jobs
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=asli-jobs.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1049235470218
NEXT_PUBLIC_FIREBASE_APP_ID=1:1049235470218:web:da1ca4a3f0966f3a43ba73
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-W2QRQ7KJGJ
