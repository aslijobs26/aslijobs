# Local Vite uses the /api proxy (see vite.config).
VITE_API_URL=/api/v1

# Optional absolute API origin for <img src> /uploads resolution in local dev.
# Defaults to http://127.0.0.1:5000 when unset. Production should set VITE_API_URL
# to the Render API instead of relying on this.
# VITE_BACKEND_ORIGIN=http://127.0.0.1:5000

# Production (Vercel) — must be set in the Vercel Production environment,
# then redeploy. Vite inlines this at build time.
# VITE_API_URL=https://aslijobs-backend.onrender.com/api/v1
#
# SPA routes (e.g. /login) require admin/vercel.json rewrites so deep links
# serve index.html instead of Vercel 404. vercel.json also proxies /api and
# /uploads to the Render backend so relative media URLs never hit index.html.

# Optional. Set to "true" only to allow local fake-token login fallback.
# Leave unset so Operations login uses the real backend JWT (required for Jobs API).
# VITE_OPERATIONS_USE_DEV_AUTH=true
#
# Requires the backend API on port 5000 (Vite proxies /api and /uploads):
#   cd backend && npm run dev
