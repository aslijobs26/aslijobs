PORT=5000
NODE_ENV=development

# Local development MUST target aslijobs_test — never aslijobs_prod.
# Production (Render) MUST target aslijobs_prod — never aslijobs_test or bare /test.
# Replace <user> / <password> / <cluster-host> with Atlas credentials (do not commit secrets).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/aslijobs_test?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Render (production) required settings — set in Render dashboard, not in git:
#   NODE_ENV=production
#   MONGO_URI=mongodb+srv://...@.../aslijobs_prod?retryWrites=true&w=majority
#
# Temporary cutover ONLY (while live data still lives on aslijobs_test):
#   NODE_ENV=production
#   ALLOW_NON_CANONICAL_PRODUCTION_DB=true
#   EXPECTED_PRODUCTION_DB_NAME=aslijobs_test
#   MONGO_URI=.../aslijobs_test
# Remove ALLOW_NON_CANONICAL_PRODUCTION_DB after migrating to aslijobs_prod.
#
# Never set ALLOW_DEV_PRODUCTION_DB=true except documented emergencies.
# See backend/docs/database-cutover-aslijobs-prod.md
# ---------------------------------------------------------------------------

JWT_ACCESS_SECRET=aslijobs-dev-access-secret-change-me
JWT_REFRESH_SECRET=aslijobs-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Public API base used in exported resume links and absolute /uploads media URLs
# (no trailing slash). Production must be the Render API origin + /api/v1.
PUBLIC_API_URL=http://localhost:5000/api/v1
RESUME_ACCESS_SECRET=aslijobs-dev-resume-access-secret-change-me
RESUME_ACCESS_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# OTP: console | whatsapp (production must be whatsapp)
OTP_PROVIDER=whatsapp
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

OTP_TEST_MODE=false
OTP_TEST_CODE=

# Prefer cloudinary even in local DEV when sharing Atlas data across machines.
# Local disk uploads are machine-specific and disappear on Render redeploys.
STORAGE_PROVIDER=cloudinary
UPLOAD_DIR=uploads

# Required when STORAGE_PROVIDER=cloudinary (also required in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=aslijobs

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
SARVAM_API_KEY=

# Selective OpenAI assist (off by default). Never commit real keys.
# Model id must be enabled on your OpenAI project (docs example: gpt-6-luna).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
WHATSAPP_OPENAI_ASSIST_ENABLED=false
OPENAI_ASSIST_MAX_TOKENS=280
OPENAI_ASSIST_TIMEOUT_MS=12000

# Download + extract inbound PDF/DOCX/TXT/images (off by default).
WHATSAPP_MEDIA_UNDERSTAND_ENABLED=false
# OCR (tesseract.js WASM). Independent of media understand — both must be true for image/scanned-PDF OCR.
WHATSAPP_OCR_ENABLED=false
WHATSAPP_OCR_LANGUAGES=eng
WHATSAPP_OCR_TIMEOUT_MS=45000
WHATSAPP_OCR_MAX_PDF_PAGES=5
WHATSAPP_OCR_PDF_SCALE=1.5
WHATSAPP_MEDIA_MAX_BYTES=8000000
WHATSAPP_MEDIA_MAX_EXTRACT_CHARS=12000
WHATSAPP_MEDIA_EXTRACT_TIMEOUT_MS=60000

JOB_VIEW_COOLDOWN_MINUTES=30

# Minutes after employer OTP verify before a WhatsApp profile-completion reminder.
EMPLOYER_PROFILE_COMPLETION_REMINDER_DELAY_MINUTES=30

# Minutes after job seeker OTP verification before jobseeker_profile_completion.
JOBSEEKER_PROFILE_COMPLETION_REMINDER_DELAY_MINUTES=30

# Local testing only. Production always waits 30 minutes after the employer
# leaves an incomplete job draft, even if this variable is shorter.
JOB_POST_INCOMPLETE_REMINDER_DELAY_MINUTES=1

NOTIFICATION_UNREAD_RETENTION_DAYS=90
NOTIFICATION_READ_RETENTION_DAYS=30
NOTIFICATION_BATCH_DELETE_LIMIT=1000
NOTIFICATION_CLEANUP_INTERVAL_MS=3600000

# Job content translation. Leave REDIS_URL empty to queue in MongoDB only.
# When set, BullMQ uses Redis and completed translations are cached.
REDIS_URL=
JOB_TRANSLATION_LANGUAGES=en,hi,te,ta,kn,ml
JOB_TRANSLATION_CACHE_TTL_SECONDS=86400
JOB_TRANSLATION_MAX_ATTEMPTS=3
JOB_TRANSLATION_WORKER_CONCURRENCY=1
WHATSAPP_INBOUND_CONCURRENCY=4

RESEND_API_KEY=
EMAIL_FROM="AsliJobs <noreply@aslijobs.com>"
