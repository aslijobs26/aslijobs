PORT=5000
NODE_ENV=development

# Local development MUST target aslijobs_test — never aslijobs_prod.
# Production (Render) MUST target aslijobs_prod — never aslijobs_test or bare /test.
# Replace <user> / <password> / <cluster-host> with Atlas credentials (do not commit secrets).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/aslijobs_test?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Render (production) required settings — set in Render dashboard, not in git:
#   NODE_ENV=production
#   MONGO_URI=mongodb+srv://...@.../aslijobs_prod?retryWrites=true&w=majority
#
# Temporary cutover ONLY (while live data still lives on aslijobs_test):
#   NODE_ENV=production
#   ALLOW_NON_CANONICAL_PRODUCTION_DB=true
#   EXPECTED_PRODUCTION_DB_NAME=aslijobs_test
#   MONGO_URI=.../aslijobs_test
# Remove ALLOW_NON_CANONICAL_PRODUCTION_DB after migrating to aslijobs_prod.
#
# Never set ALLOW_DEV_PRODUCTION_DB=true except documented emergencies.
# See backend/docs/database-cutover-aslijobs-prod.md
# ---------------------------------------------------------------------------

JWT_ACCESS_SECRET=aslijobs-dev-access-secret-change-me
JWT_REFRESH_SECRET=aslijobs-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Public API base used in exported resume links (no trailing slash)
PUBLIC_API_URL=http://localhost:5000/api/v1
RESUME_ACCESS_SECRET=aslijobs-dev-resume-access-secret-change-me
RESUME_ACCESS_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# OTP: console | whatsapp (production must be whatsapp)
OTP_PROVIDER=whatsapp
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

OTP_TEST_MODE=false
OTP_TEST_CODE=

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Production (Render) MUST use Cloudinary — local disk is ephemeral.
# STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=aslijobs

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=

JOB_VIEW_COOLDOWN_MINUTES=30

NOTIFICATION_UNREAD_RETENTION_DAYS=90
NOTIFICATION_READ_RETENTION_DAYS=30
NOTIFICATION_BATCH_DELETE_LIMIT=1000
NOTIFICATION_CLEANUP_INTERVAL_MS=3600000

RESEND_API_KEY=
EMAIL_FROM="AsliJobs <noreply@aslijobs.com>"
