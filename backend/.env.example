PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://aslijobs:Aslijobs2026@aslijobscluster.ohxo349.mongodb.net/aslijobs_test

JWT_ACCESS_SECRET=aslijobs-dev-access-secret-change-me
JWT_REFRESH_SECRET=aslijobs-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Public API base used in exported resume links (no trailing slash)
PUBLIC_API_URL=http://localhost:5000/api/v1
RESUME_ACCESS_SECRET=aslijobs-dev-resume-access-secret-change-me
RESUME_ACCESS_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Optional comma-separated extra origins (preview apps, etc.). No trailing slashes.
# CORS_ALLOWED_ORIGINS=https://preview.example.com
#
# Production tip: set FRONTEND_URL to https://www.aslijobs.com (no trailing slash).
# The API also allows the matching apex/www variant automatically.

# OTP: console | whatsapp (production must be whatsapp)
OTP_PROVIDER=whatsapp
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Development-only OTP bypass. Never enable in production.
# Must be exactly "true" to enable; missing/false disables the fixed OTP.
# OTP_TEST_CODE must be 6 digits when test mode is enabled.
OTP_TEST_MODE=false
OTP_TEST_CODE=

# Storage: local | cloudinary
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=aslijobs

# WhatsApp Cloud API (backend only — never expose these to the frontend)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Minutes before the same visitor can count another view on the same job
JOB_VIEW_COOLDOWN_MINUTES=30

# Notification inbox retention (Messages conversation history is preserved separately)
NOTIFICATION_UNREAD_RETENTION_DAYS=90
NOTIFICATION_READ_RETENTION_DAYS=30
NOTIFICATION_BATCH_DELETE_LIMIT=1000
# Cleanup interval in milliseconds (default 1 hour)
NOTIFICATION_CLEANUP_INTERVAL_MS=3600000

# Team invitation email (Resend)
# 1) Add and verify aslijobs.com at https://resend.com/domains
# 2) Set EMAIL_FROM to an address on that verified domain
# RESEND_API_KEY is required to deliver invitation emails.
RESEND_API_KEY=
EMAIL_FROM="AsliJobs <noreply@aslijobs.com>"
