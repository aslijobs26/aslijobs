{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "render-build": "npm ci --include=dev && npm run typecheck && npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:list": "node scripts/run-tests.mjs --list",
    "test:check": "node scripts/run-tests.mjs --check",
    "test:field-access": "tsx --test src/modules/rbac/field-access.test.ts",
    "test:access-level": "tsx --test src/modules/rbac/access-level-templates.test.ts",
    "translation:worker": "tsx src/modules/jobs/job-translation.worker-entry.ts",
    "translation:backfill": "tsx scripts/backfill-job-content-translations.ts",
    "knowledge:sync": "tsx scripts/sync-website-knowledge.ts",
    "knowledge:verify-crawl": "tsx scripts/verify-website-knowledge-crawl.ts",
    "knowledge:verify-e5": "tsx scripts/verify-e5-embeddings.ts",
    "knowledge:verify-browser": "tsx scripts/verify-browser-crawl.ts",
    "knowledge:extract-policies": "tsx scripts/extract-policy-corpus.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.11",
    "cheerio": "^1.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "onnxruntime-web": "^1.21.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "resend": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "onnxruntime-node@1.14.0": true,
    "sharp@0.32.6": true,
    "onnxruntime-node@1.21.0": true
  }
}
