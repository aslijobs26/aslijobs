{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/utils/cors-origins.test.ts src/middleware/validate.middleware.test.ts src/modules/rbac/*.test.ts src/modules/operations/rbac/*.test.ts src/modules/operations/jobs/operations-jobs-analytics.test.ts src/modules/operations/employers/operations-employers-export.test.ts src/modules/operations/employers/operations-employer-verification.test.ts src/modules/operations/candidates/operations-candidates-export.test.ts src/modules/operations/registration-awareness/operations-registration-awareness.test.ts src/modules/operations/verifications/operations-verifications-analytics.test.ts src/modules/operations/verifications/operations-verifications-domain.test.ts src/modules/operations/placements/operations-placements-analytics.test.ts src/modules/operations/placements/operations-placements-domain.test.ts src/modules/jobs/employer-job-verification.guard.test.ts src/modules/jobs/job-moderation.production.test.ts src/modules/job-seekers/job-seeker-hardening.production.test.ts src/modules/applications/employer-status-transition.test.ts src/modules/applications/employer-ats-placements.compat.test.ts",
    "test:field-access": "tsx --test src/modules/rbac/field-access.test.ts",
    "test:access-level": "tsx --test src/modules/rbac/access-level-templates.test.ts"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "resend": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
